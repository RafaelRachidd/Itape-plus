# Copie para backend/.env e ajuste para seu ambiente local.
# Nunca envie o arquivo .env nem a chave privada ao GitHub.
PORT=3000
FRONTEND_URL=http://localhost:5173

# ID do projeto Firebase, encontrado em Configuracoes do projeto.
FIREBASE_PROJECT_ID=itape-plus

# Caminho para a chave da conta de servico, mantida APENAS no computador.
# Ao rodar npm run dev a partir de backend/, o caminho relativo abaixo funciona.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
