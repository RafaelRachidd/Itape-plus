# Copie este arquivo para .env e preencha com os valores reais.
# O .env NUNCA vai para o GitHub (está no .gitignore).

# Connection string do Neon (painel do Neon > Connect)
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require
# Use false apenas com um PostgreSQL local sem SSL
DATABASE_SSL=true

PORT=3000
FRONTEND_URL=http://localhost:5173

# Gere uma frase longa e aleatória; cada integrante pode usar a sua em ambiente local
JWT_SECRET=troque-por-uma-frase-longa-e-aleatoria

# Administrador criado pelo "npm run db:seed" (RN08)
ADMIN_NOME=Administrador Itape +
ADMIN_EMAIL=admin@itapeplus.com
ADMIN_SENHA=troque-esta-senha
